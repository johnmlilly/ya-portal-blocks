{
	"name": "ya-portal-blocks",
	"version": "1.1.0",
	"description": "Blocks for the Youth Apostles member portal: formation and community documents, quick actions, the community calendar, and fundraising.",
	"author": "John Lilly",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"audit": "npm audit --omit=dev --audit-level=critical",
		"build": "wp-scripts build --webpack-copy-php --blocks-manifest",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js ./src",
		"packages-update": "wp-scripts packages-update",
		"playground": "npx @wp-playground/cli@latest server --auto-mount --login",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-copy-php --blocks-manifest",
		"verify": "npm run lint:js && npm run lint:css && npm run build"
	},
	"dependencies": {
		"@wordpress/block-editor": "latest",
		"@wordpress/blocks": "latest",
		"@wordpress/components": "^42.0.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/i18n": "latest",
		"@wordpress/server-side-render": "^6.33.0"
	},
	"devDependencies": {
		"@wordpress/scripts": "^35.0.0"
	}
}
