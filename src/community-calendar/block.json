{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "yamp/community-calendar",
	"version": "1.0.0",
	"title": "Community Calendar",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Member portal card with an embedded community calendar.",
	"example": {},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Community Calendar"
		},
		"calendar": {
			"type": "string",
			"default": ""
		},
		"height": {
			"type": "number",
			"default": 600
		}
	},
	"supports": {
		"html": false
	},
	"textdomain": "ya-portal-blocks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
